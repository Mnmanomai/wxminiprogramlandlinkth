/* components/cardListAsset/cardListAsset.wxss */

.section {
  display: flex;
  flex-direction: row; /* optional เพราะ default flex row */
  gap: 8px;
  width: 100%;
  overflow-x: auto; /* ให้ scroll แนวนอนได้ */
  white-space: nowrap; /* ป้องกัน line break */
}


.limit2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-weight: 600;
}
.tagcolor {
  z-index: 2;
  position: absolute;
  top: 8px;
  left: 8px;
  background: white;
  padding: 2px 10px;
  border-radius: 8px;
  font-size: 14px;
}
.cardProdMain{
  width: 100%;
  padding: 0px;
  background-color: rgba(112, 128, 144, 0.050);
  border-radius: 20px;
  border: solid 1px rgba(112, 128, 144, 0.300);
}
.cardProd {
  border-radius: 20px;
  /* border: solid 1px rgba(112, 128, 144, 0.300); */
  overflow: hidden;
  /* box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.1), 0 4px 4px 0 rgba(0, 0, 0, 0.1); */
  background-color: white;
  /* margin: 15px 0px; */
  flex: 0 0 auto; 
  position: relative;
  
}


.cardProdImage {
  width: 100%;
  height: 250px
}

.cardDetail {
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.tagdetail {
  border: 1px;
  border-radius: 4px;
  border-style: solid;
  width: auto;
  padding-left: 5px;
  padding-right: 5px;
  font-size: 12px;
}

.tagmain {
  align-items: center;
}

.cardtagandprice {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding-top: 6px;
}

.border {
  border: 2px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
}


.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.gap-1 {
  gap: 2px;
}

.gap-2 {
  gap: 3px;
}

.gap-3 {
  gap: 4px;
}

.bg-purple {
  background-color: #800080;
  color: white;
}

.bg-lightpurple {
  background-color: #DDA0DD;
  color: black;
}

.bg-green {
  color: black;
  background-color: #2E8B57;
}

.bg-orange {
  background-color: #FFA500;
  color: black;
}

.bg-yellow {
  background-color: #FFFF00;
  color: black;
}

.bg-none {
  background-color: white;
  color: black;
}

.bg-brown {
  background-color: #8B4513;
  color: white;
}

.bg-lightbrown {
  background-color: #D2B48C;
  color: black;
}

.bg-red {
  background-color: #DC143C;
  color: white;
}

.bg-blue {
  background-color: #0000FF;
  color: white;
}

.bg-greendiagonal {
  background-color: #FFFFFF;
  background-image: repeating-linear-gradient(45deg,
      #008000,
      #008000 5px,
      #ffffff 5px,
      #ffffff 10px);
  color: #000000;
}

.bg-gray {
  background-color: #696969;
  color: white;
}

.bg-olivegreen {
  background-color: #808000;
  color: white;
}

.bg-pink {
  background-color: #FFC0CB;
  color: black;
}
/* price sits above the name; everything except the name is slate-700 */
.slate {
  color: #3c4757;
}

.slate .limit2 {
  color: #000;
}

.cardprice {
  font-size: 20px;
  font-weight: 700;
  color: #334155;
}


/* photo position pill: dots on a dark translucent backdrop, bottom centre of the photo */
.imgwrap {
  position: relative;
  height: 250px;
}

.dots {
  position: absolute;
  left: 50%;
  bottom: 10px;
  transform: translateX(-50%);
  display: flex;
  gap: 5px;
  padding: 4px 8px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.45);
  z-index: 2;
  pointer-events: none;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.dot.on {
  background: #fff;
}

.dot.small {
  width: 3px;
  height: 3px;
  align-self: center;
}

/* darkening bands over the top and bottom of the photo, below the tag (z-index 2) and the dots */
.scrim {
  position: absolute;
  left: 0;
  right: 0;
  height: 60px;
  z-index: 1;
  pointer-events: none;
}

.scrim-top {
  top: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0));
}

.scrim-bottom {
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0));
}

/* favourite heart, top right of the photo (above the scrims) */
.heart {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.cardline {
  height: 1px;
  margin: 6px 14px 0;
  background: rgba(112, 128, 144, 0.300);
}

.cardactions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 10px 14px;
}

.actionbtn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 14px;
  border-radius: 16px;
  border: solid 1px rgba(112, 128, 144, 0.300);
  font-size: 13px;
  color: #334155;
  background: #fff;
}

/* price per square metre, trailing the price */
.persqm {
  font-size: 13px;
  font-weight: 400;
  color: #334155;
}


/* the hide / restore icon sits left of the heart */
.hidebtn {
  right: 46px;
}


/* label beside the headset icon */
.actiontext {
  margin-left: 4px;
  font-size: 13px;
}
