/* component/estatesection/index.wxss */
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4px 8px;
}

.title {
  font-size: 18px;
  font-weight: 700;
  color: #334155;
}

.more {
  font-size: 13px;
  color: #64748b;
}

.strip {
  width: 100%;
  white-space: nowrap;
}

.row {
  display: inline-flex;
  gap: 10px;
}

.card {
  width: 150px;
  white-space: normal;
}

.imgwrap {
  position: relative;
  width: 150px;
  height: 112px;
  border-radius: 12px;
  overflow: hidden;
  background: #f1f5f9;
}

.img {
  width: 100%;
  height: 100%;
}

/* white plate under the logo: many logos are dark or transparent */
.logo {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 54px;
  height: 28px;
  padding: 3px;
  box-sizing: border-box;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.95);
}

.logoimg {
  width: 100%;
  height: 100%;
}

/* the estate name only, on one line */
.name {
  margin-top: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
