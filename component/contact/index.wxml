<!--component/contact/index.wxml-->
<van-popup show="{{show}}" bind:close="onClose" position="bottom" round>
  <view style="padding: 20px;">
    <!-- WeChat customer service (客服 chat with the Landlink team) -->
    <button class="option-item" style="width: 100%;" open-type="contact" session-from="{{sessionFrom}}" show-message-card="{{msgTitle != ''}}"
      send-message-title="{{msgTitle}}" send-message-path="{{msgPath}}" send-message-img="{{msgImg}}">
      <van-icon name="chat-o" /> {{en ? "Customer service (chat)" : "在线客服"}}
    </button>
    <!-- the three numbers: Thai · Chinese (Cantonese) · Chinese -->
    <button wx:for="{{phones}}" wx:key="number" class="option-item" style="width: 100%;" data-number="{{item.number}}" bindtap="callNumber">
      <van-icon name="phone-o" /> {{item.label}} · {{item.shown}}
    </button>
    <button class="option-item" style="width: 100%;" bindtap="onClose">{{en ? "Cancel" : "取消"}}</button>
  </view>
</van-popup>
