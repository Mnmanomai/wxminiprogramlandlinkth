<!--pages/chat/chat.wxml-->
<view class="page-container">
  <view style="min-height: 100vh;padding-bottom: 80px;">
    <view class="row" wx:for="{{chats}}" wx:key="id" data-id="{{item.id}}" bind:tap="openRoom">
      <image class="thumb" src="{{item.asset_image ? item.asset_image : '/asset/landlink.png'}}" mode="aspectFill" />
      <view class="body">
        <view class="line1">
          <view class="who">{{item.who || (language == 'en' ? 'Landlink' : 'Landlink')}}</view>
          <view class="time">{{item.time}}</view>
        </view>
        <view class="asset">#{{item.asset_id}} {{item.asset_name}}</view>
        <view class="line3">
          <view class="last">{{item.last_message}}</view>
          <view class="badge" wx:if="{{item.unread_count > 0}}">{{item.unread_count > 99 ? '99+' : item.unread_count}}</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{loaded && chats.length == 0}}">
      <van-icon name="chat-o" size="40px" color="#c0c4cc" />
      <view class="empty-text">{{failed ? (language == 'en' ? 'Could not load your chats' : '加载失败，请稍后重试') : (language == 'en' ? 'No chats yet — open a listing and tap Chat' : '暂无消息，打开房源后点“聊一聊”')}}</view>
    </view>
  </view>
</view>
<!-- chat -->
<tabBar current="0" />
