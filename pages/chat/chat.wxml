<!--pages/chat/chat.wxml-->
<view class="page-container">
  <view class="" style="height: 100vh;">

    <view class="" wx:if="{{chatlist}}">
      <block wx:for="{{chatlist}}" wx:key="chatno">
        <chatlist chatno="{{item.group_id}}" picture="{{item.group_images}}" namechat="{{item.group_name}}" notinew="{{item.notinew}}" textnew="{{item.textnew}}" timenew="{{item.timenewtext}}" unreadno="{{item.unreadmsg}}" month="{{item.month}}" date="{{item.date}}" assetdetail="{{item.assetdetail}}"/>
      </block>
    </view>
    <view class="" wx:if="{{chatlist.length == 0}}">
      <van-empty image="search" description="暂无消息" />
    </view>
  </view>
</view>
<!-- chat -->
<tabBar current="0" />