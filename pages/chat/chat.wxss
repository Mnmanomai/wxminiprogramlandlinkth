/* pages/chat/chat.wxss */
.page-container {
  background: rgba(241, 241, 241, 0.215);
}

.row {
  display: flex;
  gap: 12px;
  padding: 12px 14px;
  background: #fff;
  border-bottom: solid 0.5px #eee;
}

.thumb {
  width: 52px;
  height: 52px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #eee;
}

.body {
  flex: 1;
  min-width: 0;
}

.line1,
.line3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.who {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  font-size: 12px;
  color: #999;
  flex-shrink: 0;
}

.asset {
  font-size: 12px;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.last {
  font-size: 14px;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: #ee0a24;
  color: #fff;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
  flex-shrink: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 80px 20px;
}

.empty-text {
  font-size: 14px;
  color: #909399;
  text-align: center;
}
