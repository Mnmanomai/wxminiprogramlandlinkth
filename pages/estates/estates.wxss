/* pages/estates/estates.wxss */
.page {
  padding: 10px 12px 40px;
}

.group {
  margin-top: 14px;
}

.gtitle {
  font-size: 17px;
  font-weight: 700;
  color: #334155;
  padding-bottom: 6px;
  border-bottom: solid 1px rgba(112, 128, 144, 0.3);
}

.gcount {
  font-size: 13px;
  font-weight: 400;
  color: #64748b;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 10px;
  margin-top: 10px;
}

.card {
  width: calc(50% - 5px);
}

.imgwrap {
  position: relative;
  width: 100%;
  height: 100px;
  border-radius: 12px;
  overflow: hidden;
  background: #f1f5f9;
}

.img {
  width: 100%;
  height: 100%;
}

.logo {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 54px;
  height: 28px;
  padding: 3px;
  box-sizing: border-box;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.95);
}

.logoimg {
  width: 100%;
  height: 100%;
}

.name {
  margin-top: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty {
  padding: 80px 20px;
  text-align: center;
  color: #909399;
  font-size: 14px;
}
