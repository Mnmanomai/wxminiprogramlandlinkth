/* pages/estatedetail/estatedetail.wxss */
.page {
  padding-bottom: 60px;
  color: #334155;
}

.cover {
  position: relative;
  width: 100%;
  height: 210px;
  background: #f1f5f9;
}

.coverimg {
  width: 100%;
  height: 100%;
}

.logo {
  position: absolute;
  top: 12px;
  left: 12px;
  width: 112px;
  height: 56px;
  padding: 6px;
  box-sizing: border-box;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.95);
}

.logoimg {
  width: 100%;
  height: 100%;
}

.body {
  padding: 14px 14px 0;
}

.h1 {
  font-size: 20px;
  font-weight: 700;
}

.sub {
  font-size: 13px;
  color: #64748b;
  margin-top: 2px;
}

.place {
  margin-top: 6px;
  font-size: 13px;
  color: #475569;
}

.box {
  margin-top: 16px;
  padding: 4px 14px;
  border: solid 1px rgba(112, 128, 144, 0.3);
  border-radius: 12px;
  background: #fff;
}

.irow {
  padding: 10px 0;
  border-bottom: solid 1px #f1f5f9;
}

.irow:last-child {
  border-bottom: none;
}

.ilabel {
  font-size: 12px;
  color: #64748b;
}

.ivalue {
  font-size: 14px;
  white-space: pre-line;
  word-break: break-all;
}


.sec {
  margin-top: 22px;
}

.sechead {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sectitle {
  font-size: 17px;
  font-weight: 700;
}

.count {
  font-size: 13px;
  font-weight: 400;
  color: #64748b;
}

.secmore {
  font-size: 13px;
  color: #64748b;
}

.company {
  padding: 10px 0;
  border-bottom: solid 1px #f1f5f9;
}

.cname {
  font-size: 14px;
  font-weight: 600;
}

.csub {
  font-size: 12px;
  color: #64748b;
}

.caddr {
  font-size: 12px;
  color: #94a3b8;
  margin-top: 2px;
}

.empty,
.fail {
  padding: 24px 0;
  text-align: center;
  color: #909399;
  font-size: 14px;
}

.fail {
  padding-top: 120px;
}
