<!--index.wxml-->
<view class="page-container">
    <scroll-view scroll-y="{{true}}" style="height: auto;">
        <view class="" style="display: flex;flex-direction: column;gap: 10px;">
            <view class="" style="position: relative;width: 100%;height: 100%;">
                <cover />
            </view>
          
            <view class="" style="transform: translate(0px,-50px);padding: 0px 10px;display: flex;flex-direction: column;gap: 10px;padding-bottom: 50px;">
            
                <view class="" style="padding: 0px 14px;">
                    <searchbar />
                </view>
                <insideout />
                <!-- Land / Warehouse / Factory entry cards -->
                <propertytypes />
                <!-- Industrial estates directory (swipeable cards → estate detail) -->
                <estatesection />
                <!-- Map: opens the listing map -->
                <mapsection />
                
                <!-- Recently viewed (local history, newest first) -->
                <view class="" wx:if="{{datarecent.length > 0}}">
                    <cardlistcol list="{{datarecent}}" title="最近浏览" />
                </view>
                <!-- Chachengsao -->
                <view class="" wx:if="{{datachachengsao.length > 0}}">
                    <cardlistcol provinceno="{{6}}" list="{{datachachengsao}}" title="北柳府" />
                </view>
                <!-- chonburi -->
                <view class="" wx:if="{{datachonburi.length > 0}}">
                    <cardlistcol provinceno="{{12}}" list="{{datachonburi}}" title="春武里府" />
                </view>
                <!-- rayong -->
                <view class="" wx:if="{{datarayong.length > 0}}">
                    <cardlistcol provinceno="{{53}}" list="{{datarayong}}" title="罗勇府" />
                </view>
                <!-- yutya -->
                <view class="" wx:if="{{datayutya.length > 0}}">
                    <cardlistcol provinceno="{{46}}" list="{{datayutya}}" title="大城府" />
                </view>
                <!-- phathum -->
                <view class="" wx:if="{{dataphathum.length > 0}}">
                    <cardlistcol provinceno="{{37}}" list="{{dataphathum}}" title="巴吞他尼府" />
                </view>
                <!-- samutprakarn -->
                <view class="" wx:if="{{datasamutprakarn.length > 0}}">
                    <cardlistcol provinceno="{{57}}" list="{{datasamutprakarn}}" title="北榄府" />
                </view>
                <!-- samutsakorn -->
                <view class="" wx:if="{{datasamutsakorn.length > 0}}">
                    <cardlistcol provinceno="{{58}}" list="{{datasamutsakorn}}" title="龙仔厝府" />
                </view>
                <news />

            </view>
        </view>
    </scroll-view>
</view>

