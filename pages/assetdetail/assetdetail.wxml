<wxs src="../../utils/utils.wxs" module="utils" />
<view class="page-container">
  <scroll-view scroll-y="true" style="height: 100vh;" scroll-into-view="{{toView}}">
    <view class="carousel-container">
      <swiper class="carousel" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular="true">
        <swiper-item wx:for="{{predata.Images}}" wx:key="index">
          <image class="carousel-image" src="{{item.filepath}}" data-index="{{index}}" mode="aspectFill"
            bind:tap="fullscreenpicture" lazy-load />
        </swiper-item>
      </swiper>
    </view>

    <view class="closedbanner" wx:if="{{predata.closed}}">
      <view style="font-weight: 600;">{{closedText}}</view>
      <view style="font-size: 12px;" wx:if="{{closedDate}}">{{language == "en" ? "Closed on" : "结束日期"}} {{closedDate}}</view>
    </view>

    <view class="" style="width: 100%;padding-bottom: 0px;">
      <view class="" style="margin: 20rpx 10px">
        <view class="" style="display: flex;gap: 4px;margin:4px 0px">
          <view class="tagHeading">{{predata.transaction}}</view>
          <view class="tagHeading">{{predata.property}}</view>
        </view>
        <view class="TagAssetName">#{{predata.assetid}} {{predata.assetname}} </view>
        <view class="text-muted">{{predata.address.district}}, {{predata.address.province}} </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.industrial_estate_name}}">
          {{language == "en" ? "Industrial estate" : "所在工业区"}} : {{predata.industrial_estate_name}}
        </view>
        <view class="text-muted" style="font-size: 12px;" wx:if="{{predata.timeago}}">
          {{language == "en" ? "Posted" : "发布于"}} {{predata.timeago}}
        </view>
        <view class="text-muted" style="font-size: 12px;" wx:if="{{predata.update_time_ago && predata.update_time_ago != predata.timeago}}">
          {{language == "en" ? "Updated" : "更新于"}} {{predata.update_time_ago}}
        </view>
        <view class="" wx:if="{{predata.price.rentcost != '0'}}">
          <view class="font-medium text-xl flex gap-2" style="font-size: 18px;font-weight: 400;">
            ฿{{utils.numberFormat(predata.price.rentcost)}} {{language == "en" ? "/ month" : "/ 月"}}
            <label class="tagBath">Baht</label>
          </view>
        </view>
        <view class="" wx:if="{{predata.price.saleprice != '0'}}">
          <view class="font-medium text-xl flex gap-2" style="font-size: 18px;font-weight: 400;align-items: flex-end;">
            ฿{{utils.numberFormat(predata.price.saleprice)}}
            <label class="tagBath">Baht</label>
          </view>
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.salepricepersqm != 0}}">
          ฿{{utils.numberFormat(predata.price.salepricepersqm)}}
          {{language == "en" ? "Bath / SQM" :"泰铢/平方米"}} {{language == "en" ? "(Land)" : "(土地)"}}
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.rentcostpersqm > 0}}">
          ฿{{utils.numberFormat(predata.price.rentcostpersqm)}}
          {{language == "en" ? "Baht / SQM / month" :"泰铢/平方米/月"}} {{language == "en" ? "(Land)" : "(土地)"}}
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.rentcostperrai > 0}}">
          ฿{{utils.numberFormat(predata.price.rentcostperrai)}}
          {{language == "en" ? "Baht / Rai / month" :"泰铢/莱/月"}} {{language == "en" ? "(Land)" : "(土地)"}}
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.salepricepersqmbuilding > 0}}">
          ฿{{utils.numberFormat(predata.price.salepricepersqmbuilding)}}
          {{language == "en" ? "Baht / SQM" :"泰铢/平方米"}} {{language == "en" ? "(Building)" : "(建筑)"}}
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.rentcostpersqmbuilding > 0}}">
          ฿{{utils.numberFormat(predata.price.rentcostpersqmbuilding)}}
          {{language == "en" ? "Baht / SQM / month" :"泰铢/平方米/月"}} {{language == "en" ? "(Building)" : "(建筑)"}}
        </view>
        <view class="text-muted" style="font-size: 14px;" wx:if="{{predata.price.salepriceperrai != 0}}">
          ฿{{utils.numberFormat(predata.price.salepriceperrai)}}
          {{language == "en" ? "Bath / Rai" :"泰铢/莱"}} {{language == "en" ? "(Land)" : "(土地)"}}
        </view>
      </view>
    </view>

    <view class="" style="display: flex; height: 86px;width: 100%;padding: 0px 0px;">
      <view class="" style="width: 100%;">
        <view class="" style="display: flex;justify-content: center;align-items: center;">
          <view class="" style="display: flex;flex-direction: column;align-items: center;gap: 4px;" bind:tap="likefunc">
            <van-icon name="like{{!likeActive ? '-o' : ''}}" size="18" class="icongroupfunc"
              color="{{likeActive ? 'red' : ''}}" />
            <view class="" style="font-size: 14px;font-weight: 400;">{{language == "en" ? "Like" : "点赞"}}
            </view>
          </view>
        </view>
      </view>
      <view class="" style="width: 100%;">
        <view class="" style="display: flex;justify-content: center;align-items: center;">
          <view class="" style="display: flex;flex-direction: column;align-items: center;gap: 4px;"
            bind:tap="scrollToMap">
            <van-icon name="location" size="18" class="icongroupfunc" />
            <view class="" style="font-size: 14px;font-weight: 400;">
              {{language == "en" ? "location" : "地点"}}
            </view>
          </view>
        </view>
      </view>
      <view class="" style="width: 100%;">
        <view class="" style="display: flex;justify-content: center;align-items: center;">
          <button class="" open-type="share"
            style="padding:0px;background-color: white;width: 100%;display: flex;flex-direction: column;align-items: center;gap: 4px">
            <van-icon name="share-o" size="18" class="icongroupfunc" />
            <view class="" style="font-size: 14px;font-weight: 400;">{{language == "en" ? "Share" : "分享"}}
            </view>
          </button>
        </view>
      </view>
    </view>

    <view class="agentcard" wx:if="{{predata.agent.name}}">
      <image class="agentpic" src="{{predata.agent.picture ? predata.agent.picture : '/asset/landlink.png'}}" mode="aspectFill" />
      <view class="agentinfo">
        <view class="agentname">{{predata.agent.name}}</view>
        <view class="text-muted" style="font-size: 12px;" wx:if="{{predata.agent.company_name_en || predata.agent.company_name_th}}">{{predata.agent.company_name_en ? predata.agent.company_name_en : predata.agent.company_name_th}}</view>
      </view>
    </view>

    <view style="padding: 0px 25rpx;padding-bottom: 60px;">
      <view class="section" wx:if="{{predata.description}}">
        <view class="Header">{{language == "en" ? "Description" : "描述"}} </view>
        <view class="text-muted text-md">{{predata.description}}</view>
      </view>

      <view class="section">
        <view class="Header"> {{language == "en" ? "Property Overview" : "物业概况"}} </view>
        <view class="SubHeader"> {{language == "en" ? "Main Location" : "主要位置"}}</view>
        <view wx:for="{{predata.placelocations}}" wx:key="distance" class="">
          <view class="flex gap-3 items-center text-muted text-md">
            <view class="text-md"> {{item.location}} : {{utils.numberFormat(item.distance)}} Km.</view>
          </view>
        </view>

        <view class="divider"></view>
        <view class="SubHeader">{{language == "en" ? "Land area" : "土地面积"}}</view>
        <view class="text-xl font-w-400">{{utils.numberFormat(predata.land.rai)}} {{language == "en" ? "rai" : "莱"}}
          {{predata.land.ngan}} {{language == "en" ? "ngan" : "颜"}} {{predata.land.sqw}} sqw
          ({{utils.numberFormat(predata.land.landarea)}} m²)
        </view>
        <view class="text-muted text-md"> {{language == "en" ? "Land Dimension" : "土地尺寸"}} :
          {{utils.numberFormat(predata.land.width)}}
          x {{utils.numberFormat(predata.land.length)}} {{language == "en" ? "m." : "米"}}
        </view>
        <view class="text-muted text-md" wx:if="{{!(predata.building.sizesqm > 0)}}"> {{language == "en" ? "Soil Improvement" : "土壤改良"}} :
          {{predata.soil_improvement == 0 ? (language == "en" ? "Filled and leveled" : "已填土整平") : (language == "en" ? "Not yet filled" : "尚未填土")}}
        </view>

        <view class="divider"></view>
        <view class="SubHeader"> {{language == "en" ? (buildingList.length > 1 ? "Total building area" : "Building area") : (buildingList.length > 1 ? "建筑总面积" : "建筑面积")}}</view>
        <view class="text-xl font-w-400"> {{utils.numberFormat(predata.building.sizesqm)}} m²</view>

        <view wx:if="{{buildingList.length > 1}}">
          <view class="buildingcard" wx:for="{{buildingList}}" wx:key="index">
            <view class="text-md" style="font-weight: 600;">
              {{language == "en" ? "Building" : "建筑"}} {{index + 1}} · {{item.typeText}}{{item.name ? ' · ' + item.name : ''}}
              — {{utils.numberFormat(item.sqm)}} m²
            </view>
            <view class="text-muted text-md" wx:if="{{item.floor > 0}}">{{language == "en" ? "Number of floors" : "楼层数"}} : {{item.floor}}</view>
            <view class="text-muted text-md" wx:if="{{item.load > 0}}">{{language == "en" ? "Floor load capacity (tons per m²)" : "地面承重（吨/平方米）"}} : {{item.load}}</view>
            <view class="text-muted text-md" wx:if="{{item.year > 0}}">{{language == "en" ? "Year built (CE)" : "建造年份（公元）"}} : {{item.year}}</view>
            <view class="text-muted text-md" wx:if="{{item.width > 0 || item.length > 0 || item.height > 0}}">{{language == "en" ? "Dimensions (W × L × H, m)" : "建筑尺寸（宽 × 长 × 高，米）"}} : {{item.width}} × {{item.length}} × {{item.height}}</view>
          </view>
        </view>

        <view wx:else>
          <view class="text-muted text-md" wx:if="{{predata.building.floor > 0}}"> {{language == "en" ? "Number of floors" : "楼层数"}} :
            {{predata.building.floor}}
          </view>
          <view class="text-muted text-md" wx:if="{{predata.building.width > 0 || predata.building.long > 0 || predata.building.height > 0}}"> {{language == "en" ? "Dimensions (W × L × H, m)" : "建筑尺寸（宽 × 长 × 高，米）"}} :
            {{predata.building.width}} × {{predata.building.long}} × {{predata.building.height}}
          </view>
          <view class="text-muted text-md" wx:if="{{predata.building.load > 0}}"> {{language == "en" ? "Floor load capacity (tons per m²)" : "地面承重（吨/平方米）"}} :
            {{predata.building.load}}
          </view>
          <view class="text-muted text-md" wx:if="{{predata.building.year != '0' && predata.building.year != ''}}"> {{language == "en" ? "Year built (CE)" : "建造年份（公元）"}} :
            {{predata.building.year}}
          </view>
        </view>

      </view>

      <view class="{{opensee ? 'hiddensee':''}}">
        <view style="padding-bottom: 60px;">
          <!-- parking lots (each an open area or a parking building) -->
          <view wx:if="{{predata.parkings.length > 0}}">
            <view class="divider"></view>
            <view class="SubHeader"> {{language == "en" ? "Parking" : "停车场"}} </view>
            <view class="buildingcard" wx:for="{{predata.parkings}}" wx:key="index">
              <view class="text-md" style="font-weight: 600;">
                {{language == "en" ? "Parking lot" : "停车场"}} {{index + 1}} ·
                {{item.type == 1 ? (language == "en" ? "Building" : "停车楼") : (language == "en" ? "Open area" : "空地")}}{{item.name ? ' · ' + item.name : ''}}
                — {{utils.numberFormat(item.sqm)}} m²
              </view>
              <view class="text-muted text-md" wx:if="{{item.type == 1 && item.floor > 0}}">{{language == "en" ? "Number of floors" : "楼层数"}} : {{item.floor}}</view>
              <view class="text-muted text-md" wx:if="{{item.year > 0}}">{{language == "en" ? "Year built (CE)" : "建造年份（公元）"}} : {{item.year}}</view>
              <view class="text-muted text-md" wx:if="{{item.width > 0 || item.length > 0 || item.height > 0}}">{{language == "en" ? "Dimensions (W × L × H, m)" : "尺寸（宽 × 长 × 高，米）"}} : {{item.width}} × {{item.length}} × {{item.height}}</view>
            </view>
          </view>
          <!-- the old single parking (car / trailer counts) for listings that have no lots -->
          <view wx:elif="{{predata.parking.size > 0 || predata.parking.truck > 0 || predata.parking.cars > 0}}">
          <view class="divider"></view>
          <view class="SubHeader"> {{language == "en" ? "Parking area" : "停车场"}} </view>
          <view class="text-xl">{{predata.parking.size}} m²</view>
          <view class="text-muted text-md"> {{language == "en" ? "Parking Dimension" : "停车位尺寸"}} :
            {{predata.parking.width}} x {{predata.parking.long}} {{language == "en" ? "m." : "米"}}
          </view>
          <view class="text-muted text-md"> {{language == "en" ? "Trailer Truck Parking" : "拖车停车场" }} :
            {{predata.parking.truck}}
          </view>
          <view class="text-muted text-md"> {{language == "en" ? "Cars Parking" : "汽车停车场"}} :
            {{predata.parking.cars}}
          </view>
          </view>

          <view class="divider"></view>
          <view class="SubHeader"> {{language == "en" ? "Location Area" : "定位区域"}} </view>
          <view class="text-muted text-md">{{language == "en" ? "Industrial Zone" : "工业区"}} :
            {{predata.industrial}}
          </view>
          <view class="text-muted text-md">{{language == "en" ? "Free Zone" : "保税区"}} : {{predata.freezone}}
          </view>

          <view class="divider"></view>
          <view class="SubHeader"> {{language == "en" ? "Property Detail" : "物业详情"}} </view>
          <view class="text-muted text-md">{{language == "en" ? "Property Type" : "物业类型"}} : {{predata.property}}
          </view>
          <view class="text-muted text-md">{{language == "en" ? "Property Color" : "属性颜色"}} :
            {{predata.cityplan.text}}
          </view>
        </view>

        <view class="section" id="section_map">
          <view class="Header"> {{language == "en" ? "Maps": "地图"}}</view>
          <map id="map" latitude="{{lat}}" longitude="{{long}}" scale="14" style="width: 100%; height: 300px;"
            markers="{{markers}}" circles="{{circles}}" />
        </view>

      </view>

      <view class="" style="display: flex;justify-content: center;font-weight: 600;" wx:if="{{opensee}}" bind:tap="toggleopensee">{{language == "en" ? "Show more" : "展开更多"}}</view>

      <view class="" style="display: flex;gap: 8px;padding: 3px;padding-top: 20px;overflow-x: scroll;">
        <block wx:for="{{nearasset}}" wx:key="nearasset">
          <minicard AssetId="{{item.id}}" AssetType="{{item.propertytype}}" AssetColor="{{item.cityplan.name_default}}"
            AssetName="{{nameasset}}" Images="{{item.pictures[0].filepath}}" Province="{{item.province}}"
            District="{{item.district}}" SalePriceBath="{{item.saleprice}}" RentCostPerMonthBath="{{item.rentcost}}"
            AreaLandRai="{{item.land_sizerai}}" AreaLandNgan="{{item.land_sizengan}}"
            AreaLandSqw="{{item.land_sizesqw}}" AreaWH="{{item.land_sizesqm}}" Time="{{item.create_date}}"
            Transactiontype="{{item.transactiontype}}" Industrailtype="{{item.industrailtype}}"
            Freezonetype="{{item.freezonetype}}" />
        </block>
      </view>
    </view>
  </scroll-view>

  <movable-area class="movable-area" wx:if="{{!predata.closed}}">
    <movable-view class="support-btn" direction="all" x="{{x}}" y="{{y}}" inertia="true" out-of-bounds="false"
      bindtap="showPopup">
      <image src="/asset/landlink.png" mode="aspectFill"
        style="width:100px;height:100px;margin-bottom: 20px;position: absolute;top:-23px" />
    </movable-view>
  </movable-area>

</view>