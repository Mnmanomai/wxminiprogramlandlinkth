/* pages/assetdetail/assetdetail.wxss */

.page-container {
  background-color: white;
}

.text-muted {
  color: rgb(122, 122, 122);
}

.section {
  margin: 10px 0px;
}

.Header {
  font-size: 20px;
  font-weight: 700;
  color: rgb(2, 2, 73);
}

.SubHeader {
  font-size: 18px;
  font-weight: 500;
  color: rgb(35, 35, 65);
}

.carousel-container {
  width: 100%;
  height: 300px;
  position: relative;
  overflow: hidden;
}

.carousel {
  width: 100%;
  height: 100%;
}

.carousel-image {
  width: 100%;
  height: 100%;
  display: block;
}

.tagBath {
  background-color: rgba(169, 169, 169, 0.2);
  color: rgb(169, 169, 169);
  font-size: 10px;
  padding-left: 2px;
  padding-right: 2px;
  border-radius: 2px;
}

.tagHeading {
  background-color: rgba(169, 169, 169, 0.2);
  color: rgb(169, 169, 169);
  font-size: 11px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-radius: 2px;
}

.icongroupfunc {
  padding: 16px;
  background-color: rgba(169, 169, 169, 0.192);
  border-radius: 100%;
}

.divider {
  height: 1px;
  background-color: #e0e0e048;
  margin: 16rpx 0;
}

.text-xl {
  font-size: 16px;
}

.text-md {
  font-size: 14px;
}

.font-w-400 {
  font-weight: 400;
}

.TagAssetName{
  width: 100%;word-break: break-word; overflow-wrap: break-word;font-size: 18px;font-weight: 400;
}

.movable-area {
  position: fixed;
  width: 100vw;
  height: 100vh;
  top: 0;
  left: 0;
  pointer-events: none; /* กันไม่ให้บังหน้าจอ */
  z-index: 999;
}

.support-btn {
  width: 56px;
  height: 56px;
  background: #fcfcfc;
  border-radius: 50%;
  color: #fff;
  text-align: center;
  position: relative;
  display: flex;
  justify-content: center;
  line-height: 56px;
  font-size: 26px;
  box-shadow: 0 4px 12px rgba(0,0,0,.25);
  pointer-events: auto;
}

.hiddensee{
  max-height: 100px; 
  overflow: hidden;
  position: relative;
  
  /* สร้าง Layer การจางหาย */
  -webkit-mask-image: linear-gradient(to bottom, black 10%, transparent 100%);
  mask-image: linear-gradient(to bottom, black 10%, transparent 100%);
}
/* one building of a listing that has several */
.buildingcard {
  background-color: rgb(248, 248, 248);
  border-radius: 12px;
  padding: 10px 12px;
  margin-top: 10px;
}

/* closed listing banner */
.closedbanner {
  background-color: rgb(55, 65, 81);
  color: #fff;
  padding: 10px 14px;
  text-align: center;
}

/* seller (name / company follow the website's tier visibility — decided by the API) */
.agentcard {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 10px 14px;
  padding: 10px 12px;
  border: solid 0.8px rgb(201, 201, 201);
  border-radius: 12px;
  background-color: rgb(250, 250, 250);
}

.agentpic {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #eee;
}

.agentname {
  font-weight: 600;
}
