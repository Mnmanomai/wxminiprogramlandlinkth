<!--pages/activities/activities.wxml-->
<!-- <navigation-bar title="活动" back="{{false}}" color="black" background="#FFF" /> -->
<tabBar current="1" />

<view class="page-container" style="height: auto;">
  <van-tabs active="{{ active }}" swipeable sticky offset-top="{{0}}" style="width: 100%;height: auto;">
    <van-tab title="收藏列表">
      <view class="viewInContent" >
        <view wx:if="{{FlavoriteList .length > 0}}">
          <cardlistasset list="{{FlavoriteList}}" />
        </view>
        <view wx:else="">
          <van-empty image="search" description="没有符合您搜索条件的产品。" />
        </view>
      </view>
    </van-tab>
    <!-- listings the user hid from the search page; the eye icon on a card brings it back -->
    <van-tab title="已隐藏">
      <view class="viewInContent">
        <view wx:if="{{HiddenList.length > 0}}">
          <cardlistasset list="{{HiddenList}}" hide-mode="restore" bind:hidechange="onRestored" />
        </view>
        <view wx:else="">
          <van-empty image="search" description="{{language == 'en' ? 'No hidden listings' : '没有隐藏的房源'}}" />
        </view>
      </view>
    </van-tab>
  </van-tabs>
</view>