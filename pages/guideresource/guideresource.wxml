<view class="page-container">

  <view class="header">
    <text class="header-title">投资信息查询</text>
    <text class="header-sub">泰国投资指南 · Thailand Investment Guide</text>
  </view>

  <view class="search-section">
    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="请输入问题或关键词..." placeholder-class="search-placeholder" value="{{searchVal}}" bindinput="onSearchInput" bindconfirm="onSearchSubmit" confirm-type="search" adjust-position="{{true}}" />
      <view class="search-btn {{searchVal ? 'active' : ''}}" bindtap="onSearchSubmit">
        <text>搜索</text>
      </view>
    </view>
  </view>

  <view class="category-section">
    <scroll-view scroll-x="{{true}}" class="tag-scroll" show-scrollbar="{{false}}">
      <view class="tag-row">
        <view wx:for="{{categories}}" wx:key="id" class="tag {{selectedCategory === item.id ? 'tag-active' : ''}}" bindtap="onCategoryTap" data-id="{{item.id}}">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-y="{{true}}" class="main-scroll" show-scrollbar="{{false}}">

    <!-- DEFAULT STATE -->
    <block wx:if="{{!hasSearched}}">

      <!-- Hot Q&A -->
      <view class="section" wx:if="{{hotQaList.length > 0}}">
        <view class="section-header">
          <text class="section-title">🔥 热门问题</text>
          <text class="section-more" bindtap="showAllFaq">查看全部</text>
        </view>
        <scroll-view scroll-x="={{true}}" show-scrollbar="{{false}}" class="hot-qa-scroll">
          <view class="hot-qa-row">
            <view wx:for="{{hotQaList}}" wx:key="id" class="hot-aq-card" bindtap="onHotQaTap" data-question="{{item.question}}" data-answer="{{item.answer}}" data-agency="{{item.agency}}">
              <text class="hot-qa-badge">{{item.agency}}</text>
              <text class="hot-qa-q">{{item.question}}</text>
              <text class="hot-qa-preview">{{item.answer}}</text>
              <view class="hot-qa-footer">
                <text class="hot-qa-fire">🔥 {{item.helpful_count||0}}</text>
                <text class="hot-qa-read">查看回答 ›</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- ALL FAQ Model -->
      <view class="faq-modal-overlay" wx:if="{{showAllFaqModal}}" bindtap="closeAllFaq">
        <view class="faq-modal-box" catchtap="noop">
          <view class="faq-modal-header">
            <text class="faq-modal-title">🔥 热门问题</text>
            <text class="faq-modal-close" bindtap="closeAllFaq">✕</text>
          </view>
          <scroll-view scroll-y="{{true}}" class="faq-modal-scroll" show-scrollbar="{{false}}" style="height: 60vh; box-sizing: border-box;">
            <view wx:for="{{allFaqList}}" wx:key="id" class="faq-modal-item">
              <view class="faq-modal-top">
                <text class="faq-modal-agency">{{item.agency}}</text>
                <text class="faq-modal-count">🔥 {{item.helpful_count || 0}}</text>
              </view>
              <text class="faq-modal-q" bindtap="onHotQaTap" data-question="{{item.question}}" data-answer="{{item.answer}}" data-agency="{{item.agency}}">{{item.question}}</text>
              <text class="faq-modal-a">{{item.answer}}</text>
            </view>
            <view wx:if="{{allFaqList.length === 0}}" class="faq-modal-empty">
              <text>暂无热门问题</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- History -->
      <view class="section" wx:if="{{queryHistory.length > 0}}">
        <view class="section-header">
          <text class="section-title">查询记录</text>
          <text class="section-clear" bindtap="clearHistory">清除</text>
        </view>
        <view class="history-list">
          <view wx:for="{{queryHistory}}" wx:key="id" class="history-item" bindtap="onHistoryTap" data-query="{{item.query}}">
            <text class="history-icon">🕐</text>
            <text class="history-text">{{item.query}}</text>
            <text class="history-time">{{item.time}}</text>
          </view>
        </view>
      </view>

      <!-- Agencies -->
      <view class="section">
        <text class="section-title">相关机构</text>
        <view class="agency-list">
          <view wx:for="{{agencies}}" wx:key="id" class="agency-item" bindtap="onAgencyTap" data-id="{{item.id}}" data-label="{{item.name}}">
            <view class="agency-left">
              <text class="agency-icon">{{item.icon}}</text>
              <view>
                <text class="agency-name">{{item.name}}</text>
                <text class="agency-desc">{{item.desc}}</text>
              </view>
            </view>
            <text class="agency-arrow">›</text>
          </view>
        </view>
      </view>

    </block>

    <!-- RESULT STATE -->
    <block wx:else>

      <view class="loading-wrap" wx:if="{{isLoading}}">
        <view class="dot-typing">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <text class="loading-text">正在搜索...</text>
      </view>

      <block wx:else>
        <view class="result-meta">
          <view class="back-to-agencies" bindtap="onSearchClear">
            <text class="back-arrow">‹</text>
            <text class="back-text">返回</text>
          </view>
          <text class="result-count">找到 {{results.length}} 条结果 · "{{lastQuery}}"</text>
        </view>

        <view wx:for="{{results}}" wx:key="id" class="result-card" bindtap="onResultTap" data-id="{{item.id}}" data-item="{{item}}">
          <view class="result-tag-row">
            <text class="result-tag">{{item.agency}}</text>
          </view>
          <text class="result-title">{{item.title}}</text>
          <text class="result-body">{{item.summary}}</text>
          <text class="result-more">查看详情 ›</text>
        </view>

        <view class="empty-state" wx:if="{{results.length === 0}}">
          <text class="empty-icon">🔍</text>
          <text class="empty-title">未找到相关信息</text>
          <text class="empty-desc">请尝试其他关键词或选择上方机构</text>
        </view>
      </block>

    </block>

    <view style="height: 30rpx;"></view>
  </scroll-view>

  <!-- Hot Q&A Modal -->
  <view class="modal-overlay" wx:if="{{showQaModal}}" bindtap="closeQaModal">
    <view class="modal-box" catchtap="noop">
      <view class="modal-header">
        <text class="modal-agency">{{modalQa.agency}}</text>
        <text class="modal-close" bindtap="closeQaModal">✕</text>
      </view>
      <text class="modal-q">{{modalQa.question}}</text>
      <text class="modal-a">{{modalQa.answer}}</text>
      <view class="modal-btn" bindtap="goToAgency" data-agency="{{modalQa.agency}}">
        <text>查看更多 {{modalQa.agency}} 信息 ›</text>
      </view>
    </view>
  </view>

</view>
<tabBar current="0" />