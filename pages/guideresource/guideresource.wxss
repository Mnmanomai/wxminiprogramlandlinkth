.page-container {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* header */
.header {
  padding: 60rpx 40rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #EAEEF2;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #8A94A6;
}

/* search */
.search-section{
  background: #ffffff;
  padding:  20rpx 30rpx 24rpx;
  border-bottom:1rpx solid #EAEEF2;
}
.search-wrap{
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border: 1rpx solid #EAEEF2;
  border-radius: 20rpx;
  padding: 0 20rpx;
  gap :12rpx
}
.search-icon{
  font-size: 28rpx;
  flex-shrink: 0;
}
.search-input{
  flex: 1;
  height: 80rpx;
  font-size: 28rpx; 
  color: #1A1A2E;
  background: transparent;
}
.search-placeholder {
  color: #C0C8D4;
  font-size: 28rpx;
}
.search-btn {
  padding: 10rpx 24rpx;
  background: #D1D8E0;
  border-radius: 14rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}
.search-btn text {
  font-size: 24rpx;
  color: #8A94A6;
  font-weight: 500;
}

.search-btn.active {
  background: #0F6E56;
}

.search-btn.active text {
  color: #ffffff;
}
/* ===== CATEGORY TAGS ===== */
.category-section {
  background: #ffffff;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EAEEF2;
}

.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  padding: 0 30rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #F5F7FA;
  border: 1rpx solid #EAEEF2;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #8A94A6;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.tag-active {
  background: #E8F5F1;
  border-color: #5DCAA5;
  color: #085041;
  font-weight: 500;
}

/* ===== MAIN SCROLL ===== */
.main-scroll {
  flex: 1;
  height: 0;
}

/* ===== SECTIONS ===== */
.section {
  margin: 24rpx 30rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.section-title {
  display: block;
  font-size: 22rpx;
  color: #8A94A6;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.section-clear {
  font-size: 22rpx;
  color: #0F6E56;
}

/* ===== HISTORY ===== */
.history-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #EAEEF2;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: #F5F7FA;
}

.history-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.history-text {
  flex: 1;
  font-size: 26rpx;
  color: #4A5568;
}

.history-time {
  font-size: 20rpx;
  color: #C0C8D4;
  flex-shrink: 0;
}

/* ===== POPULAR TOPICS ===== */
.popular-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.popular-item {
  background: #ffffff;
  border: 1rpx solid #EAEEF2;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: all 0.2s;
}

.popular-item:active {
  background: #E8F5F1;
  border-color: #5DCAA5;
}

.popular-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.popular-label {
  font-size: 24rpx;
  color: #4A5568;
  line-height: 1.4;
}

/* ===== AGENCY LIST ===== */
.agency-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #EAEEF2;
}

.agency-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
  transition: background 0.15s;
}

.agency-item:last-child {
  border-bottom: none;
}

.agency-item:active {
  background: #F5F7FA;
}

.agency-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.agency-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  width: 60rpx;
  text-align: center;
}

.agency-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.agency-desc {
  display: block;
  font-size: 22rpx;
  color: #8A94A6;
}

.agency-arrow {
  font-size: 32rpx;
  color: #C0C8D4;
  flex-shrink: 0;
}

/* ===== LOADING ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
  gap: 20rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #8A94A6;
}

.dot-typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #5DCAA5;
  border-radius: 50%;
  animation: dotBlink 1.4s infinite ease-in-out both;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBlink {
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.2); }
}

/* ===== RESULT STATE ===== */
.result-meta {
  padding: 20rpx 30rpx 10rpx;
}

.result-count {
  font-size: 22rpx;
  color: #8A94A6;
}

.result-card {
  background: #ffffff;
  border: 1rpx solid #EAEEF2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 14rpx 30rpx 0;
  transition: all 0.2s;
}

.result-card:active {
  background: #F5F7FA;
  border-color: #5DCAA5;
}

.result-tag-row {
  margin-bottom: 8rpx;
}

.result-tag {
  display: inline-block;
  font-size: 20rpx;
  background: #E8F5F1;
  color: #085041;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  font-weight: 500;
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.result-body {
  display: block;
  font-size: 24rpx;
  color: #8A94A6;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.result-more {
  display: block;
  font-size: 24rpx;
  color: #0F6E56;
  font-weight: 500;
}

/* ===== EMPTY STATE ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #4A5568;
}

.empty-desc {
  font-size: 24rpx;
  color: #8A94A6;
  text-align: center;
  line-height: 1.6;
}

/* ===== HOT Q&A ===== */
.hot-qa-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hot-qa-item {
  background: #ffffff;
  border: 1rpx solid #EAEEF2;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  transition: all 0.2s;
}

.hot-qa-item:active {
  background: #F0FAF6;
  border-color: #5DCAA5;
}

.hot-qa-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hot-qa-agency {
  font-size: 20rpx;
  background: #E8F5F1;
  color: #085041;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  font-weight: 500;
}

.hot-qa-count {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.hot-icon {
  font-size: 20rpx;
}

.hot-count {
  font-size: 20rpx;
  color: #8A94A6;
}

.hot-qa-q {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A2E;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.hot-qa-a {
  display: block;
  font-size: 23rpx;
  color: #8A94A6;
  line-height: 1.5;
  /* ตัดที่ 2 บรรทัด */
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== MODAL ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-box {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.modal-agency {
  font-size: 22rpx;
  background: #E8F5F1;
  color: #085041;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 32rpx;
  color: #8A94A6;
  padding: 10rpx;
}

.modal-q {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.modal-a {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.modal-btn {
  background: #0F6E56;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.modal-btn text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ===== HOT Q&A HORIZONTAL CARDS ===== */
.section-more {
  font-size: 24rpx;
  color: #0F6E56;
  font-weight: 500;
}

.hot-qa-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 0 0 4rpx;
  overflow: hidden;
  
}

.hot-qa-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 30rpx 12rpx;
}

.hot-qa-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  flex-shrink: 0;
  background: #ffffff;
  border: 2rpx solid #D1FAE5;  /* เขียวอ่อน ชัดขึ้น */
  border-radius: 20rpx;         /* มนขึ้น */
  padding: 18rpx;
  gap: 8rpx;
  white-space: normal;
  box-shadow: 0 4rpx 16rpx rgba(15, 110, 86, 0.1);  /* เงาเขียวอ่อน */
}

.hot-qa-card:active {
  background: #F0FAF6;
  border-color: #5DCAA5;
  transform: scale(0.97);
}

.hot-qa-badge {
  display: inline-block;
  font-size: 20rpx;
  background: #E8F5F1;
  color: #085041;
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  font-weight: 500;
  align-self: flex-start;
}

.hot-qa-q {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A2E;
  line-height: 1.4;
}

.hot-qa-preview {
  display: block;
  font-size: 22rpx;
  color: #8A94A6;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.hot-qa-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

.hot-qa-fire {
  font-size: 20rpx;
  color: #8A94A6;
}

.hot-qa-read {
  font-size: 22rpx;
  color: #0F6E56;
  font-weight: 500;
}

/* ===== FAQ ALL MODAL ===== */
.faq-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.faq-modal-box {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  height: 75vh;          
  max-height: 75vh;     
  display: flex;
  flex-direction: column;
  overflow: hidden;     
}


.faq-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #EAEEF2;
  flex-shrink: 0;
}

.faq-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.faq-modal-close {
  font-size: 32rpx;
  color: #8A94A6;
  padding: 10rpx;
}

.faq-modal-scroll {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  box-sizing: border-box;
}

.faq-modal-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F7FA;
  width: 100%;
  box-sizing: border-box;
}

.faq-modal-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.faq-modal-agency {
  font-size: 20rpx;
  background: #E8F5F1;
  color: #085041;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.faq-modal-count {
  font-size: 20rpx;
  color: #8A94A6;
}

.faq-modal-q {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A2E;
  margin-bottom: 8rpx;
  line-height: 1.5;
  white-space: normal;
  word-wrap: break-word;
  width: 100%;
}

.faq-modal-a {
  display: block;
  font-size: 24rpx;
  color: #8A94A6;
  line-height: 1.6;
  white-space: normal;
  word-wrap: break-word;
  width: 100%;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.faq-modal-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8A94A6;
}
