/* pages/chatroom/chatroom.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.asset {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  background: #fff;
  border-bottom: solid 0.5px #eee;
}

.thumb {
  width: 40px;
  height: 40px;
  border-radius: 6px;
  background: #eee;
  flex-shrink: 0;
}

.assetinfo {
  flex: 1;
  min-width: 0;
}

.assetname {
  font-size: 14px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assetsub {
  font-size: 12px;
  color: #999;
}

.list {
  flex: 1;
  min-height: 0;
  padding: 0 12px;
  box-sizing: border-box;
}

.more {
  text-align: center;
  color: #999;
  padding: 6px;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  max-width: 78%;
}

.msg.mine {
  align-items: flex-end;
  margin-left: auto;
}

.msg.theirs {
  align-items: flex-start;
}

.bubble {
  padding: 8px 12px;
  border-radius: 14px;
  font-size: 15px;
  line-height: 1.4;
  word-break: break-all;
  white-space: pre-wrap;
}

.mine .bubble {
  background: #06304e;
  color: #fff;
}

.theirs .bubble {
  background: #fff;
  color: #222;
}

.when {
  font-size: 11px;
  color: #aaa;
  margin-top: 2px;
}

.bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: solid 0.5px #eee;
}

.field {
  flex: 1;
  height: 38px;
  padding: 0 12px;
  border-radius: 19px;
  background: #f3f3f3;
  font-size: 15px;
}

.sendbtn {
  padding: 8px 14px;
  border-radius: 18px;
  background: #cfd6dc;
  color: #fff;
  font-size: 14px;
}

.sendbtn.on {
  background: #06304e;
}

.closed {
  padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
  background: #fff;
  border-top: solid 0.5px #eee;
  text-align: center;
  color: #888;
  font-size: 14px;
}
